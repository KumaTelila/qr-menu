# Copy this to .env.local and fill in your values

# MongoDB connection string (get from MongoDB Atlas - free tier)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/qrmenu?retryWrites=true&w=majority

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-this

# Your production URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (used for initial login)
ADMIN_EMAIL=admin@yourbusiness.com
ADMIN_PASSWORD=changeme123

# Your restaurant/cafe public URL shown in QR code
NEXT_PUBLIC_MENU_URL=http://localhost:3000/menu

# Restaurant info shown on menu
NEXT_PUBLIC_RESTAURANT_NAME=Buna House
NEXT_PUBLIC_RESTAURANT_TAGLINE=Specialty Coffee & Kitchen
NEXT_PUBLIC_CURRENCY=ETB
